{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "paths": {
      "src/*": [
        "./src/*"
      ]
    },
    "strict": true,
    "useDefineForClassFields": true,
    "resolveJsonModule": true,
    "lib": [
      "ES2021",
      "DOM",
      "DOM.Iterable"
    ],
    "noEmit": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
}
